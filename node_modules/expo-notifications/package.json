{
  "name": "expo-notifications",
  "version": "58.1.6",
  "description": "Provides an API to fetch push notification tokens and to present, schedule, receive, and respond to notifications.",
  "keywords": [
    "expo",
    "expo-notifications",
    "notifications",
    "push-nofifications",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/notifications/",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-notifications"
  },
  "sideEffects": [
    "./build/DevicePushTokenAutoRegistration.fx.js"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "dependencies": {
    "@expo/image-utils": "^0.12.5",
    "abort-controller": "^3.0.0",
    "badgin": "^1.1.5",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13"
  },
  "devDependencies": {
    "@expo/internal-scripts": "58.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "expo": "58.0.17",
    "memfs": "^3.6.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "scripts": {
    "precompile-android": "et prebuild-android-package-for-publish",
    "build": "pnpm run build:lib && pnpm run build:plugin",
    "build:lib": "expo-build src",
    "build:plugin": "expo-build --base plugin cjs:src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -b tsconfig.all.json"
  }
}
{
  "expo": {
    "name": "Книголандия",
    "slug": "knigolandia-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "knigolandiaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.alordiel.knigolandiaapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A0102",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alordiel.knigolandiaapp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splashscreen.jpg",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
